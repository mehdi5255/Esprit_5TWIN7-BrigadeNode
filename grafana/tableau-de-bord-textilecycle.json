{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud)",
      "description": "Source de données Prometheus de la stack : grafanacloud-…-prom",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "title": "TextileCycle — Supervision",
  "description": "Disponibilité du site (Synthetic Monitoring) et métriques métier des 5 modules (page /metrics de Laravel).",
  "uid": "textilecycle-supervision",
  "tags": ["textilecycle", "devops"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "${DS_PROMETHEUS}", "value": "${DS_PROMETHEUS}" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Disponibilité du site (Grafana Synthetic Monitoring)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Disponibilité (période affichée)",
      "description": "Part des vérifications réussies (/up et page d'accueil, depuis Paris, Francfort et Londres).",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "avg(avg_over_time(probe_success{job=\"TextileCycle - site public\"}[$__range]))", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2, "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.99 }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Site en ligne ?",
      "id": 3,
      "gridPos": { "h": 5, "w": 4, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "min(probe_success{job=\"TextileCycle - site public\"})" } ],
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": {
            "0": { "text": "HORS LIGNE", "color": "red" }, "1": { "text": "EN LIGNE", "color": "green" }
          } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Temps de réponse par sonde",
      "description": "Durée totale du check (les deux requêtes). Les pics correspondent au réveil du site par Render (offre gratuite).",
      "id": 4,
      "gridPos": { "h": 5, "w": 14, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "avg by (probe) (probe_duration_seconds{job=\"TextileCycle - site public\"})", "legendFormat": "{{probe}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "row",
      "title": "Impact et activité (page /metrics de TextileCycle)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 10
    },
    {
      "type": "stat", "title": "Utilisateurs", "id": 11,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "sum(textilecycle_utilisateurs)" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Vêtements dans les dressings", "id": 12,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_vetements" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Vêtements sauvés", "description": "Réparés, transformés ou donnés.", "id": 13,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_vetements_sauves" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "CO₂ évité", "id": 14,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_co2_evite_kg" } ],
      "fieldConfig": { "defaults": { "unit": "masskg", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Eau économisée", "id": 15,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_eau_evitee_litres" } ],
      "fieldConfig": { "defaults": { "unit": "litre", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Réparations récupérées", "id": 16,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_reparations_chiffre_euros" } ],
      "fieldConfig": { "defaults": { "unit": "currencyEUR", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "piechart", "title": "Comptes par rôle", "id": 17,
      "gridPos": { "h": 9, "w": 6, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_utilisateurs > 0", "legendFormat": "{{role}}", "instant": true } ],
      "options": {
        "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }
      }
    },
    {
      "type": "bargauge", "title": "Demandes par module", "id": 18,
      "gridPos": { "h": 9, "w": 6, "x": 6, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "sum by (module) (textilecycle_demandes)", "legendFormat": "{{module}}", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "min": 0 } },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Demandes en cours (en attente, acceptées, au dépôt, en traitement, prêtes)", "id": 19,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ {
        "refId": "A",
        "expr": "sum by (module) (textilecycle_demandes{statut=~\"en_attente|acceptee|depot_remis|en_traitement|pret\"})",
        "legendFormat": "{{module}}"
      } ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "table", "title": "Détail des demandes par statut", "id": 20,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_demandes", "format": "table", "instant": true } ],
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
          "indexByName": { "module": 0, "statut": 1, "Value": 2 },
          "renameByName": { "module": "Module", "statut": "Statut", "Value": "Demandes" }
        } }
      ],
      "options": { "sortBy": [ { "displayName": "Module", "desc": false } ] }
    },
    {
      "type": "bargauge", "title": "Ateliers et associations", "id": 21,
      "gridPos": { "h": 10, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_structures > 0", "legendFormat": "{{type}} — {{statut}}", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "min": 0 } },
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Événements solidaires", "id": 22,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_evenements" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Version déployée", "id": 23,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_info", "legendFormat": "Laravel {{laravel}} · PHP {{php}} · {{env}}", "instant": true } ],
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Technique",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 30
    },
    {
      "type": "timeseries", "title": "Temps de réponse de la base MySQL (Aiven)", "id": 31,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "textilecycle_base_donnees_latence_secondes", "legendFormat": "latence" } ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries", "title": "Lecture de /metrics par Grafana (1 = réussie)", "id": 32,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "refId": "A", "expr": "max(up{job=~\".*textilecycle.*\"})", "legendFormat": "scrape /metrics" } ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "lineWidth": 2 } } }
    }
  ]
}
